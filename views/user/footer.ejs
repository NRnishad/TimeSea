<!-- ════════════════════════════════════════════
     TimeSea Footer — Modern Minimal | 2025
     ════════════════════════════════════════════ -->
<style>
  /* ── Footer Styles ──────────────────────── */
  .ts-footer {
    background: #0f0f0f;
    color: rgba(255, 255, 255, 0.72);
    padding: 3.5rem 0 0;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    margin-top: auto;
  }

  .ts-footer .footer-brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  .ts-footer .footer-tagline {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }

  .ts-footer .social-links {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
  }

  .ts-footer .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.65) !important;
    font-size: 0.95rem;
    transition: all 0.22s;
  }

  .ts-footer .social-links a:hover {
    background: #ffffff;
    color: #0f0f0f !important;
    border-color: #ffffff;
  }

  .ts-footer .footer-col-title {
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .ts-footer .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ts-footer .footer-links li {
    margin-bottom: 0.6rem;
  }

  .ts-footer .footer-links a {
    color: rgba(255, 255, 255, 0.58) !important;
    font-size: 0.875rem;
    transition: color 0.2s;
    text-decoration: none !important;
  }

  .ts-footer .footer-links a:hover {
    color: #ffffff !important;
  }

  /* Newsletter */
  .ts-footer .newsletter-input-group {
    display: flex;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    overflow: hidden;
    margin-top: 0.75rem;
  }

  .ts-footer .newsletter-input-group input {
    flex: 1;
    background: rgba(255, 255, 255, 0.07);
    border: none;
    color: #fff;
    padding: 0.55rem 0.85rem;
    font-size: 0.82rem;
    outline: none;
    font-family: 'Inter', sans-serif;
  }

  .ts-footer .newsletter-input-group input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .ts-footer .newsletter-input-group button {
    background: #ffffff !important;
    border: none !important;
    color: #0f0f0f !important;
    padding: 0.55rem 1rem !important;
    font-size: 0.78rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.04em !important;
    cursor: pointer !important;
    border-radius: 0 !important;
    font-family: 'Inter', sans-serif !important;
    transition: background 0.2s !important;
    white-space: nowrap;
  }

  .ts-footer .newsletter-input-group button:hover {
    background: #e0e0e0 !important;
  }

  .ts-footer .newsletter-note {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.35);
    margin-top: 0.5rem;
  }

  /* Footer bottom bar */
  .ts-footer-bottom {
    background: #080808;
    padding: 1.1rem 0;
    margin-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .ts-footer-bottom .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ts-footer-bottom .copy {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.38);
  }

  .ts-footer-bottom .legal-links {
    display: flex;
    gap: 1.2rem;
  }

  .ts-footer-bottom .legal-links a {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.38) !important;
    transition: color 0.2s;
  }

  .ts-footer-bottom .legal-links a:hover {
    color: rgba(255, 255, 255, 0.75) !important;
  }

  /* Payment badges */
  .ts-footer .payment-badges {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.2rem;
    flex-wrap: wrap;
  }

  .ts-footer .pay-badge {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 0.25rem 0.55rem;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .ts-footer .row>div {
      margin-bottom: 2rem;
    }

    .ts-footer-bottom .bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<footer class="ts-footer">
