        </ul>
      </div>

      <!-- Col 3: Support -->
      <div class="col-lg-3 col-md-6 mb-4">
        <h6 class="footer-col-title">Support</h6>
        <ul class="footer-links">
          <li><a href="#">Help Center</a></li>
          <li><a href="#">Contact Us</a></li>
          <li><a href="#">FAQs</a></li>
