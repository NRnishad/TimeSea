        <p style="font-size:0.82rem; color:rgba(255,255,255,0.48); margin-bottom:0.4rem; line-height:1.5;">
          Get exclusive drops, limited editions, and style guides — no spam, unsubscribe anytime.
        </p>
        <div class="newsletter-input-group">
          <input type="email" placeholder="you@example.com" />
          <button type="button">Subscribe</button>
        </div>
        <p class="newsletter-note">By subscribing you agree to our <a href="#"
            style="color:rgba(255,255,255,0.45); text-decoration:underline !important;">Privacy Policy</a>.</p>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="ts-footer-bottom">
    <div class="container">
      <div class="bottom-inner">
        <span class="copy">© 2025 TimeSea. All rights reserved.</span>
        <div class="legal-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms & Conditions</a>
          <a href="#">Cookie Policy</a>
        </div>
      </div>
    </div>
  </div>
</footer>