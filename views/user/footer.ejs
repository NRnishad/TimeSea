      </div>

      <!-- Col 2: Shop -->
      <div class="col-lg-2 col-md-6 mb-4">
        <h6 class="footer-col-title">Shop</h6>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/shop">All Watches</a></li>
