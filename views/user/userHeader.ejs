<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TimeSea — Luxury Timepieces</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <!-- Global Styles -->
    <link href="/style/styles.css" rel="stylesheet" type="text/css" />

    <style>
      /* ── Navbar ───────────────────────────── */
      .ts-navbar {
        background-color: #0f0f0f;
        padding: 0.75rem 0;
        position: sticky;
        top: 0;
        z-index: 1030;
        box-shadow: 0 2px 12px rgba(0,0,0,0.18);
      }

      .ts-brand {
        font-family: 'Playfair Display', serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: #ffffff !important;
        letter-spacing: 0.02em;
        transition: opacity 0.2s;
      }
      .ts-brand:hover { opacity: 0.82; }

      /* Nav links */
      .ts-navbar .nav-link {
        color: rgba(255,255,255,0.78) !important;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.4rem 0.75rem !important;
        position: relative;
        transition: color 0.2s;
        letter-spacing: 0.02em;
      }
      .ts-navbar .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0.75rem; right: 0.75rem;
        height: 1.5px;
        background: #ffffff;
        transform: scaleX(0);
        transition: transform 0.22s ease;
        border-radius: 2px;
      }
      .ts-navbar .nav-link:hover,
      .ts-navbar .nav-link.active-link {
        color: #ffffff !important;
      }
      .ts-navbar .nav-link:hover::after { transform: scaleX(1); }

      /* Icon action buttons */
      .ts-icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        color: rgba(255,255,255,0.78) !important;
        font-size: 1.15rem;
        transition: background 0.2s, color 0.2s;
        position: relative;
      }
      .ts-icon-btn:hover {
        background: rgba(255,255,255,0.12);
        color: #ffffff !important;
      }

      /* Cart badge */
      .ts-cart-badge {
        position: absolute;
        top: 2px; right: 2px;
        background: #e63946;
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        border-radius: 50%;
        width: 16px; height: 16px;
        display: flex; align-items: center; justify-content: center;
        line-height: 1;
      }

      /* Toggler */
      .ts-toggler {
        border: 1.5px solid rgba(255,255,255,0.35) !important;
        border-radius: 6px !important;
        padding: 0.35rem 0.55rem !important;
        color: #fff !important;
        background: transparent !important;
        box-shadow: none !important;
      }
      .ts-toggler:focus { box-shadow: none !important; }
      .ts-toggler .bi { font-size: 1.2rem; color: #fff; }

      /* Mobile collapse menu */
      .ts-collapse-inner {
        padding: 0.75rem 0;
        border-top: 1px solid rgba(255,255,255,0.1);
        margin-top: 0.5rem;
      }
      .ts-collapse-inner .nav-link {
        padding: 0.55rem 0.5rem !important;
        font-size: 0.9rem;
      }
      .ts-collapse-inner .nav-link::after { display: none; }

      .ts-mobile-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.5rem 0;
        border-top: 1px solid rgba(255,255,255,0.08);
        margin-top: 0.5rem;
      }
      .ts-mobile-actions a {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: rgba(255,255,255,0.75) !important;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.35rem 0.6rem;
        border-radius: 6px;
        transition: background 0.2s, color 0.2s;
      }
      .ts-mobile-actions a:hover {
        background: rgba(255,255,255,0.1);
        color: #fff !important;
      }

      /* Radio override */
      input[type="radio"] {
        appearance: none;
        background-color: #f0f0f0;
        margin: 0;
        font: inherit;
        color: #737373;
        width: 18px;
        height: 18px;
        border: 2px solid #ccc;
        border-radius: 50%;
        display: inline-block;
        position: relative;
        cursor: pointer;
      }
      input[type="radio"]:checked {
        background-color: #111;
        border-color: #111;
      }
      input[type="radio"]:checked::after {
        content: '';
        position: absolute;
        top: 4px; left: 4px;
        width: 6px; height: 6px;
        border-radius: 50%;
        background: white;
      }
      input[type="radio"]:hover {
        border-color: #888;
      }
      label {
        margin-left: 6px;
        font-size: 0.9rem;
        color: #555;
        cursor: pointer;
      }

      /* Footer spacing */
      footer {
        margin-top: auto;
      }
    </style>
  </head>
  <body>
    <header>
      <nav class="ts-navbar navbar navbar-expand-lg">
        <div class="container">

          <!-- Brand -->
          <a class="navbar-brand ts-brand" href="/">TimeSea</a>

          <!-- Mobile: action icons + hamburger -->
          <div class="d-flex align-items-center gap-2 d-lg-none ms-auto">
            <% if (user && user.cart && user.cart.length > 0) { %>
            <a href="/cart" class="ts-icon-btn position-relative">
              <i class="bi bi-bag"></i>
              <span class="ts-cart-badge"><%= user.cart.length %></span>
            </a>
            <% } else { %>
            <a href="/cart" class="ts-icon-btn"><i class="bi bi-bag"></i></a>
            <% } %>
            <a href="/userAccount" class="ts-icon-btn"><i class="bi bi-person"></i></a>
            <button class="ts-toggler navbar-toggler ms-1"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#tsNavCollapse"
              aria-controls="tsNavCollapse"
              aria-expanded="false"
              aria-label="Toggle navigation">
              <i class="bi bi-list"></i>
            </button>
          </div>

          <!-- Collapsible content -->
          <div class="collapse navbar-collapse" id="tsNavCollapse">

            <!-- Desktop: left-side nav links -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a class="nav-link" href="/">Home</a>
              </li>
              <% if (user) { %>
              <li class="nav-item">
                <a class="nav-link" href="/shop">Shop</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/wallet">Wallet</a>
              </li>
              <% } %>
            </ul>

            <!-- Desktop: right-side icon actions -->
            <div class="d-none d-lg-flex align-items-center gap-1">
              <a href="/wishlist" class="ts-icon-btn" title="Wishlist">
                <i class="bi bi-heart"></i>
              </a>
              <a href="/cart" class="ts-icon-btn position-relative" title="Cart">
                <i class="bi bi-bag"></i>
                <% if (user && user.cart && user.cart.length > 0) { %>
                <span class="ts-cart-badge"><%= user.cart.length %></span>
                <% } %>
              </a>
              <a href="/userAccount" class="ts-icon-btn" title="Account">
                <i class="bi bi-person"></i>
              </a>
            </div>

            <!-- Mobile: stacked nav links shown in collapse -->
            <div class="d-lg-none ts-collapse-inner">
              <ul class="navbar-nav">
                <li class="nav-item">
                  <a class="nav-link" href="/">Home</a>
                </li>
                <% if (user) { %>
                <li class="nav-item">
                  <a class="nav-link" href="/shop">Shop</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/wallet">Wallet</a>
                </li>
                <% } %>
              </ul>
              <div class="ts-mobile-actions">
                <a href="/wishlist"><i class="bi bi-heart"></i> Wishlist</a>
                <a href="/cart">
                  <i class="bi bi-bag"></i> Cart
                  <% if (user && user.cart && user.cart.length > 0) { %>
                  <span class="badge bg-danger rounded-pill" style="font-size:9px"><%= user.cart.length %></span>
                  <% } %>
                </a>
                <a href="/userAccount"><i class="bi bi-person"></i> Account</a>
              </div>
            </div>

          </div><!-- /collapse -->
        </div><!-- /container -->
      </nav>
    </header>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
