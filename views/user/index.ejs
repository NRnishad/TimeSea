<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TimeSea — Luxury Timepieces</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <!-- Global Styles -->
  <link href="/style/styles.css" rel="stylesheet" type="text/css" />

  <style>
    /* ── Home Page Specific ─────────────── */
    .home-hero {
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.10);
      margin-bottom: 2.5rem;
      background: #111;
    }

    .home-hero img {
      width: 100%;
      max-height: 460px;
      object-fit: cover;
      display: block;
      opacity: 0.95;
    }

    .products-section {
      padding: 1rem 0 3rem;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.7rem;
      font-weight: 700;
      color: #0f0f0f;
      margin-bottom: 0.3rem;
    }

    .section-subtitle {
      font-size: 0.85rem;
      color: #888;
      margin-bottom: 2rem;
    }

    .section-title-line {
      width: 38px;
      height: 3px;
      background: #111;
      border-radius: 2px;
      margin-bottom: 0.6rem;
    }

    /* Product Cards */
    .ts-product-card {
      border: 1px solid #ebebeb;
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
      transition: transform 0.22s ease, box-shadow 0.22s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .ts-product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.10);
      border-color: #ddd;
    }

    .ts-product-card .card-image-wrapper {
      overflow: hidden;
      background: #f8f8f8;
      height: 220px;
    }

    .ts-product-card .card-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.38s ease;
      display: block;
    }

    .ts-product-card:hover .card-image-wrapper img {
      transform: scale(1.04);
    }

    .ts-product-card .card-info {
      padding: 0.85rem 0.9rem 1rem;
      text-align: center;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.3rem;
    }

    .ts-product-card .card-name {
      font-size: 0.875rem;
      font-weight: 600;
      color: #111;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin: 0;
    }

    .ts-product-card .card-price {
      font-size: 0.875rem;
      font-weight: 700;
      color: #333;
      margin: 0;
    }

    .ts-product-card .card-price span {
      font-size: 0.72rem;
      font-weight: 400;
      color: #999;
      margin-right: 2px;
    }

    /* Grid spacing */
    .product-col {
      margin-bottom: 1.5rem;
    }

    /* Pagination */
    .ts-pagination {
      display: flex;
      justify-content: center;
      gap: 0.35rem;
      padding: 2rem 0 1rem;
      flex-wrap: wrap;
    }

    .ts-pagination a,
    .ts-pagination span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 36px;
      height: 36px;
      padding: 0 0.65rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 0.82rem;
      color: #333 !important;
      font-weight: 500;
      text-decoration: none !important;
      transition: all 0.2s;
      background: #fff;
    }

    .ts-pagination a:hover {
      background: #0f0f0f;
      color: #fff !important;
      border-color: #0f0f0f;
    }

    .ts-pagination .active-page {
      background: #0f0f0f;
      color: #fff !important;
      border-color: #0f0f0f;
      pointer-events: none;
    }

    .ts-pagination .disabled-page {
      color: #ccc !important;
      pointer-events: none;
      background: #fafafa;
    }

    @media (max-width: 575px) {
      .home-hero img {
        max-height: 200px;
      }

      .section-title {
        font-size: 1.3rem;
      }
    }
  </style>
</head>

<body>
  <%- include('userHeader') %>

    <main>
      <div class="container py-4">

        <!-- Hero Banner -->
        <div class="home-hero">
          <img
            src="https://m.media-amazon.com/images/G/31/img21/Watches2024/Feb/Categorypage/Hero/PC/14._CB581348226_.jpg"
            alt="Featured Watches — TimeSea" />
        </div>

        <!-- Products Section -->
        <section class="products-section">
          <div class="section-title-line"></div>
          <h2 class="section-title">Our Collection</h2>
          <p class="section-subtitle">Handpicked luxury timepieces for every wrist</p>

          <div class="row">
            <% products.forEach((product, index)=> { %>
              <div class="col-xl-3 col-lg-4 col-md-4 col-6 product-col">
                <a href="/productDetails?id=<%= product._id %>" style="text-decoration:none !important; color:inherit;">
                  <div class="ts-product-card">
                    <div class="card-image-wrapper">
                      <img src="/<%= product.image[0] %>" alt="<%= product.title %>" />
                    </div>
                    <div class="card-info">
                      <p class="card-name">
                        <%= product.title %>
                      </p>
                      <p class="card-price"><span>Rs.</span>
                        <%= product.salePrice %>
                      </p>
                    </div>
                  </div>
                </a>
              </div>
              <% }); %>
          </div>

          <!-- Pagination -->
          <% if (products.length> 0 && (nextPage || current == pages)) { %>
            <nav aria-label="Product Pagination">
              <div class="ts-pagination">
                <% if (current==1) { %>
                  <span class="disabled-page">First</span>
                  <% } else { %>
                    <a href="?page=1">First</a>
                    <% } %>

                      <% var i=(Number(current)> 5 ? Number(current) - 4 : 1) %>
                        <% if (i !==1) { %>
                          <span class="disabled-page">…</span>
                          <% } %>

                            <% for (; i < Number(current) + 4 && i <=pages; i++) { %>
                              <% if (i==current) { %>
                                <span class="active-page">
                                  <%= i %>
                                </span>
                                <% } else { %>
                                  <a href="/?page=<%= i %>">
                                    <%= i %>
                                  </a>
                                  <% } %>
                                    <% } %>

                                      <% if (i==Number(current) + 4 && i < pages) { %>
                                        <span class="disabled-page">…</span>
                                        <% } %>

                                          <% if (current==pages) { %>
                                            <span class="disabled-page">Last</span>
                                            <% } else { %>
                                              <a href="/?page=<%= pages %>">Last</a>
                                              <% } %>
              </div>
            </nav>
            <% } %>

        </section>
      </div>
    </main>

    <%- include('footer') %>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>